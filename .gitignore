# Rust build artifacts
/target/

# Distribution binaries
/dist/

# Binary firmware files (large, proprietary)
*.bin
*.frf
*.odx
*.a2l
*.flashable_block*

# Allow the embedded data files needed for compilation, by name. An explicit
# allow-list rather than `!data/*.bin`, so a firmware image dropped into data/
# stays ignored instead of becoming trackable.
!data/mqb_dsg_key.bin
!data/patch.bin
!data/patch_1810.bin
!data/patch_1841.bin

# Session logs / debug logs
*.log

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Claude Code local settings
.claude/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store
